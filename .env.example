# ===========================================
# njadder v1.2.1 — Environment Variables
# ===========================================
# Copy this file to `.env` (local) or set these on Vercel Project Settings → Environment Variables.

# --- Database ---
# Local dev (SQLite):
DATABASE_URL="file:./db/custom.db"

# On Vercel, use Vercel Postgres (recommended):
# 1. Go to Vercel → Storage → Create Database → Postgres
# 2. Copy the connection string and set DATABASE_URL below
# 3. Update prisma/schema.prisma: change `provider = "sqlite"` to `provider = "postgresql"`
# DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# --- NextAuth ---
# Required for JWT signing. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-32-char-string"

# Where the app is deployed. Used for canonical URLs and cookies.
# Local dev:
NEXTAUTH_URL="http://localhost:3000"

# On Vercel (set automatically OR manually):
# NEXTAUTH_URL="https://your-app.vercel.app"

# --- Optional: Email provider (for password reset / verification emails) ---
# If you want to send real verification emails on signup, set up Resend:
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="njadder <noreply@yourdomain.com>"
# Without these, email is auto-verified on signup (current behavior).
